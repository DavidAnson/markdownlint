    "| Text  | *emphasis* | __strong__ | \`code\`   | [link](https://example.com) |",
    "| Text  | *emphasis* | __strong__ | \`code\`   | [link](https://example.com) |",
    "",
    "<!-- markdownlint-configure-file {",
    "  \\"code-block-style\\": false,",
    "  \\"descriptive-link-text\\": false,",
    "  \\"heading-style\\": false",
    "} -->",
    ""
  ]
}
`;

